<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><nav class="navbar navbar-expand-lg navbar-dark rd-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-mark">R</span> RaceDay</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>@if(Context.Session.GetString("Role")=="Organiser"){<li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Create">Create event</a></li>}@if(Context.Session.GetString("Role")=="Participant"){<li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My entries</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a></li>}</ul><div class="d-flex align-items-center gap-3">@if(Context.Session.GetString("ApiCookie")!=null){<a class="small text-white-50 text-decoration-none" asp-controller="Profile" asp-action="Index">Hi, @Context.Session.GetString("FullName")</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">Sign out</button></form>}else{<a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Sign in</a><a class="btn btn-sm btn-lime" asp-controller="Account" asp-action="Register">Join RaceDay</a>}</div></div></div></nav><main class="container py-4"><partial name="_Alerts"/>@RenderBody()</main><footer class="rd-footer"><div class="container d-flex justify-content-between flex-wrap gap-2"><span>© @DateTime.Now.Year RaceDay</span><span>Run your race. Own your pace.</span></div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>

@model List<EventDto>
@{ViewData["Title"]="Dashboard";var role=ViewBag.Role as string;}
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4"><div><span class="eyebrow">YOUR RACE HQ</span><h1 class="page-title">Welcome back, @Context.Session.GetString("FullName")</h1><p class="text-muted mb-0">@if(role=="Organiser"){<text>Here's what's happening across your events.</text>}else{<text>Your next challenge could be just around the corner.</text>}</p></div><a class="btn btn-lime" asp-controller="Events" asp-action="Index">Browse events <span>→</span></a></div><div class="stat-strip">@if(role=="Organiser"){<div><small>TOTAL EVENTS</small><strong>@ViewBag.TotalEvents</strong></div><div><small>UPCOMING EVENTS</small><strong>@ViewBag.UpcomingEventsCount</strong></div><div><small>PARTICIPANT ENTRIES</small><strong>@ViewBag.TotalEnrolments</strong></div>}else{<div><small>UPCOMING EVENTS</small><strong>@Model.Count</strong></div><div><small>YOUR ROLE</small><strong>@role</strong></div><div><small>RACEDAY STATUS</small><strong class="text-success">READY</strong></div>}</div><form method="get" class="row g-2 mt-4 mb-2"><div class="col-md-6"><input name="search" class="form-control" placeholder="Search events or locations" value="@(Context.Request.Query["search"].ToString())"/></div><div class="col-md-3"><select name="eventType" class="form-select"><option value="">All event types</option><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-md-3"><button class="btn btn-dark w-100">Filter events</button></div></form><div class="d-flex justify-content-between align-items-center mt-5 mb-3"><h2 class="section-title">@(role=="Organiser"?"Recently created events":"Upcoming events")</h2>@if(role=="Organiser"){<a asp-controller="Events" asp-action="Create" class="text-link">+ Create event</a>}</div><div class="row g-4">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><div class="event-card">@if(!string.IsNullOrEmpty(e.BannerImageUrl)){<img class="event-image" src="@e.BannerImageUrl" alt="Event banner"/>}else{<div class="event-placeholder">RACE<span>DAY</span></div>}<div class="p-3"><div class="d-flex justify-content-between"><span class="event-type">@e.EventType</span><span class="text-muted small">@e.DistanceKm km</span></div><h3>@e.EventName</h3><p class="text-muted small mb-2">@e.Location · @e.EventDate.ToString("dd MMM yyyy")</p>@if(role=="Organiser"){var counts=ViewBag.EnrolmentCounts as Dictionary<int,int>??new();<p class="small fw-semibold">@(counts.GetValueOrDefault(e.EventId)) participant entries</p>}<a class="text-link" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">View event →</a></div></div></div>}@if(Model.Count==0){<div class="col-12"><div class="alert alert-light border mb-0">@if(role=="Organiser"){<text>You haven't created any events yet. <a asp-controller="Events" asp-action="Create">Create your first event.</a></text>}else{<text>No upcoming events match your filters. Try changing your search or event type.</text>}</div></div>}</div>

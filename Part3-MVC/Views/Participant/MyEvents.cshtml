@model List<EnrolmentDto>
@{ViewData["Title"]="My entries";}<span class="eyebrow">YOUR RACE HISTORY</span><h1 class="page-title">My event entries</h1><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Category</th><th>Enrolment date</th><th>Status</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.EventName</td><td>@e.CategoryName</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="status-pill confirmed">@e.Status</span></td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="text-muted">You haven't entered an event yet. <a asp-controller="Events" asp-action="Index">Find one now.</a></p>}

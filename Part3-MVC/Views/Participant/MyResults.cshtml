@model List<ResultDto>
@{ViewData["Title"]="My results";}<span class="eyebrow">THE FINISH LINE</span><h1 class="page-title">My results</h1><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Event date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var r in Model.OrderBy(x=>x.FinishPosition)){<tr><td>@r.EventName</td><td>@r.EventDate.ToString("dd MMM yyyy")</td><td>@r.CategoryName</td><td>@(r.FinishTime?.ToString("hh\\:mm\\:ss")??"Pending")</td><td>@(r.FinishPosition.HasValue?"#"+r.FinishPosition:"—")</td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="text-muted">Your results will appear here after an organiser publishes them.</p>}

@model EventEnrolmentsVm
@{ViewData["Title"]="Event enrolments";}
<span class="eyebrow">ORGANISER STUDIO</span><h1 class="page-title">Participant entries</h1><p class="text-muted">Review registrations and publish finish-line results after the event.</p><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Participant</th><th>Category</th><th>Enrolled</th><th>Status</th><th>Finish time</th><th>Position</th><th></th></tr></thead><tbody>@foreach(var e in Model.Enrolments){Model.ResultsByEnrolment.TryGetValue(e.EnrolmentId,out var result);<tr><td class="fw-semibold">@e.ParticipantName</td><td>@e.CategoryName</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="status-pill confirmed">@e.Status</span></td>@if(result!=null){<td>@result.FinishTime?.ToString("hh\\:mm\\:ss")</td><td>@(result.FinishPosition.HasValue?"#"+result.FinishPosition:"—")</td><td><span class="text-success small fw-semibold">Recorded</span></td>}else{<td colspan="3"><form asp-action="CaptureResult" method="post" class="d-flex gap-2 flex-wrap"><input type="hidden" name="id" value="@e.EnrolmentId"/><input type="hidden" name="eventId" value="@Model.EventId"/><input name="FinishTime" class="form-control form-control-sm" style="max-width:130px" placeholder="hh:mm:ss" required aria-label="Finish time for @e.ParticipantName"/><input name="FinishPosition" type="number" min="1" class="form-control form-control-sm" style="max-width:90px" placeholder="Place" required aria-label="Finish position for @e.ParticipantName"/><button class="btn btn-sm btn-dark">Save result</button></form></td>}</tr>}@if(Model.Enrolments.Count==0){<tr><td colspan="7" class="text-muted text-center py-4">No participants have enrolled yet.</td></tr>}</tbody></table></div><a asp-action="Details" asp-route-id="@Model.EventId" class="text-link">← Back to event</a>

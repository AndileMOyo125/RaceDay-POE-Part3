@model EventDto
@{ViewData["Title"]=Model.EventName;var cats=ViewBag.Categories as List<CategoryDto>??new();}
<div class="event-detail">@if(!string.IsNullOrEmpty(Model.BannerImageUrl)){<img class="detail-banner" src="@Model.BannerImageUrl" alt="Event banner"/>}else{<div class="detail-banner event-placeholder">RACE<span>DAY</span></div>}<div class="detail-body"><span class="event-type">@Model.EventType · @Model.DistanceKm km</span><h1 class="page-title">@Model.EventName</h1><p class="lead">@Model.Description</p><p class="text-muted">📍 @Model.Location<br/>📅 @Model.EventDate.ToString("dddd, dd MMMM yyyy · HH:mm")<br/>Organised by @Model.OrganiserName</p><hr/><h2 class="section-title">Available categories</h2>@foreach(var c in cats){<div class="category-row"><strong>@c.CategoryName</strong><span class="text-muted">@(c.MinAge.HasValue?"Age "+c.MinAge+"–"+c.MaxAge:"Open category")</span></div>}@if(cats.Count==0){<p class="text-muted">No categories have been added yet.</p>}
@if(Context.Session.GetString("Role")=="Participant"){<form asp-action="Enrol" method="post" class="mt-4"><input type="hidden" name="id" value="@Model.EventId"/><label class="form-label">Choose your category</label><select class="form-select mb-3" name="categoryId" required>@foreach(var c in cats){<option value="@c.CategoryId">@c.CategoryName</option>}</select><button class="btn btn-lime" disabled="@(cats.Count==0)">Enter this event</button></form>}
@if(Context.Session.GetString("Role")=="Organiser"){<div class="organiser-actions"><a class="btn btn-lime" asp-action="Edit" asp-route-id="@Model.EventId">Edit event</a><a class="btn btn-outline-dark" asp-action="Enrolments" asp-route-id="@Model.EventId">View enrolments</a><form asp-action="Delete" asp-route-id="@Model.EventId" method="post" onsubmit="return confirm('Delete this event and its related entries?')"><button class="btn btn-outline-danger">Delete</button></form></div><hr/><h3 class="section-title">Add a category</h3><form asp-action="AddCategory" asp-route-id="@Model.EventId" method="post" class="row g-2"><div class="col-md-6"><input name="CategoryName" class="form-control" placeholder="e.g. 10 km Open" required maxlength="50"/></div><div class="col-md-2"><input name="MinAge" type="number" class="form-control" placeholder="Min age" min="0" max="120"/></div><div class="col-md-2"><input name="MaxAge" type="number" class="form-control" placeholder="Max age" min="0" max="120"/></div><div class="col-md-2"><button class="btn btn-dark w-100">Add</button></div></form>}
</div></div>

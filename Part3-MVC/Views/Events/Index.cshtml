@model List<EventDto>
@{ViewData["Title"]="Events";}
<div class="d-flex justify-content-between align-items-end mb-4"><div><span class="eyebrow">THE STARTING LINE</span><h1 class="page-title">@(Context.Session.GetString("Role")=="Organiser"?"Your events":"Find your next event")</h1><p class="text-muted">Local races, walks and rides worth showing up for.</p></div>@if(Context.Session.GetString("Role")=="Organiser"){<a class="btn btn-lime" asp-action="Create">+ New event</a>}</div><form method="get" class="row g-2 mb-4"><div class="col-md-6"><input name="search" class="form-control" placeholder="Search event or location" value="@(Context.Request.Query["search"].ToString())"/></div><div class="col-md-3"><select name="eventType" class="form-select"><option value="">All event types</option><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-md-3"><button class="btn btn-dark w-100">Filter events</button></div></form><div class="row g-4">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><div class="event-card">@if(!string.IsNullOrEmpty(e.BannerImageUrl)){<img class="event-image" src="@e.BannerImageUrl" alt="@e.EventName banner"/>}else{<div class="event-placeholder">RACE<span>DAY</span></div>}<div class="p-3"><div class="d-flex justify-content-between"><span class="event-type">@e.EventType</span><span class="small text-muted">@e.DistanceKm km</span></div><h3>@e.EventName</h3><p class="small text-muted">@e.Location<br/>@e.EventDate.ToString("ddd, dd MMM yyyy · HH:mm")</p><a class="text-link" asp-action="Details" asp-route-id="@e.EventId">Event details →</a></div></div></div>}@if(Model.Count==0){<p class="text-muted">No events found yet.</p>}</div>
